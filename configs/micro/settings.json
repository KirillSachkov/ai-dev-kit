{
    "colorscheme": "catppuccin-mocha",
    "mkparents": true,
    "tabstospaces": true,
    "tabsize": 4,
    "autoindent": true,
    "smartpaste": true,
    "softwrap": true,
    "wordwrap": true,
    "cursorline": true,
    "scrollbar": true,
    "diffgutter": true,
    "matchbrace": true,
    "savecursor": true,
    "saveundo": true,
    "rmtrailingws": true,
    "ruler": true,
    "mouse": true,
    "statusline": true,
    "incsearch": true,
    "hlsearch": true,
    "ignorecase": true,
    "scrollmargin": 3,
    "clipboard": "external"
}
