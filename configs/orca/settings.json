{
  "theme": "system",
  "uiLanguage": "system",
  "appFontFamily": "Geist",
  "editorFontFamily": "",
  "editorWordWrap": true,
  "editorMinimapEnabled": false,
  "editorAutoSave": false,
  "terminalFontSize": 14,
  "terminalFontFamily": "JetBrainsMono Nerd Font Mono",
  "terminalLineHeight": 1,
  "terminalLigatures": "auto",
  "terminalCursorStyle": "block",
  "terminalCursorBlink": false,
  "terminalThemeDark": "Catppuccin Mocha",
  "terminalThemeLight": "Catppuccin Latte",
  "terminalUseSeparateLightTheme": true,
  "terminalScrollbackRows": 50000,
  "terminalMouseHideWhileTyping": true,
  "terminalFocusFollowsMouse": false,
  "terminalClipboardOnSelect": true,
  "terminalCopyTrimsGutter": true,
  "terminalAllowOsc52Clipboard": true,
  "openLinksInApp": false,
  "openAgentTabsInChatByDefault": false,
  "defaultTuiAgent": "codex",
  "disabledTuiAgents": [],
  "claudeAgentTeamsMode": "off",
  "defaultTaskSource": "linear",
  "defaultTaskViewPreset": "all",
  "compactWorktreeCards": true,
  "diffDefaultView": "side-by-side",
  "diffWordWrap": false,
  "sourceControlViewMode": "list",
  "agentStatusHooksEnabled": true,
  "nestWorkspaces": true,
  "ctrlTabOrderMode": "mru",
  "terminalShortcutPolicy": "orca-first",
  "experimentalNativeChat": false,
  "experimentalStructuredNativeChat": false,
  "terminalMacOptionAsAlt": "true",
  "terminalPaddingX": 12,
  "terminalPaddingY": 12,
  "terminalBackgroundOpacity": 1,
  "terminalColorOverrides": {
    "background": "#171717"
  },
  "agentDefaultArgs": {
    "claude": "--dangerously-skip-permissions",
    "claude-agent-teams": "--dangerously-skip-permissions",
    "openclaude": "--dangerously-skip-permissions",
    "codex": "--dangerously-bypass-approvals-and-sandbox",
    "gemini": "--yolo",
    "antigravity": "--dangerously-skip-permissions",
    "aider": "--yes-always",
    "amp": "--dangerously-allow-all",
    "kiro": "--trust-all-tools",
    "crush": "--yolo",
    "autohand": "--unrestricted",
    "cline": "--auto-approve true",
    "command-code": "--yolo",
    "continue": "--allow \"*\"",
    "cursor": "--yolo",
    "kimi": "--yolo",
    "mistral-vibe": "--agent auto-approve",
    "qwen-code": "--approval-mode yolo",
    "rovo": "--yolo",
    "hermes": "--yolo",
    "copilot": "--yolo",
    "grok": "--permission-mode bypassPermissions",
    "devin": "--permission-mode bypass",
    "ante": "--yolo",
    "trae": "--yolo",
    "droid": ""
  },
  "agentCmdOverrides": {},
  "nativeChatSessionOptions": {}
}
